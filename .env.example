# devcontainer initializeCommand copies this to .env on first start.

# --- Postgres ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=db_name

# --- MLflow ---
MLFLOW_BACKEND_DB=db_name

# --- LLM ---
# Locally: put values here. In CODESPACES: define them as Repository Secrets
# instead and leave these blank -- a key that never touches a file cannot be
# committed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=embedding_model
EMBEDDING_DIMENSIONS=384

# --- Budget guard ---
BUDGET_TOTAL_USD=10.00
BUDGET_GENERATION_USD=9.00
BUDGET_WARN_PCT=0.70

# --- App ---
LOG_LEVEL=INFO
ENV=dev
